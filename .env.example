# Environment variables for local development.
# Copy this file to .env and adjust the values: cp .env.example .env
# Never commit .env; it is git-ignored. Put real secrets only in .env.
# Run services from the repository root so they find this .env.
# docker compose also reads .env, but pins each HTTP service to port 8000 inside its
# container and sets the URLs services use to reach each other.

# --- catalog-service --------------------------------------------------------

# Interface the HTTP server binds to. Default: 0.0.0.0 (all interfaces).
CATALOG_SERVICE_HOST=0.0.0.0
# Port the HTTP server listens on with `uv run`. Default: 8000.
CATALOG_SERVICE_PORT=8000
# Uvicorn log level: critical, error, warning, info, debug or trace. Default: info.
CATALOG_SERVICE_LOG_LEVEL=info
# Host port docker compose maps to the container. Default: 8000.
CATALOG_SERVICE_HOST_PORT=8000

# --- order-service ----------------------------------------------------------

# Interface the HTTP server binds to. Default: 0.0.0.0.
ORDER_SERVICE_HOST=0.0.0.0
# Port the HTTP server listens on with `uv run`. Default: 8001.
ORDER_SERVICE_PORT=8001
# Uvicorn log level. Default: info.
ORDER_SERVICE_LOG_LEVEL=info
# Base URL of catalog-service. Default: http://localhost:8000.
ORDER_SERVICE_CATALOG_URL=http://localhost:8000
# Seconds to wait for catalog-service before answering 503. Default: 5.0.
ORDER_SERVICE_CATALOG_TIMEOUT_SECONDS=5.0
# Host port docker compose maps to the container. Default: 8001.
ORDER_SERVICE_HOST_PORT=8001

# --- import-worker ----------------------------------------------------------

# Directory polled for *.json import files. Default: data/inbox.
IMPORT_WORKER_INBOX_DIR=data/inbox
# Where imported files are moved. Default: data/processed.
IMPORT_WORKER_PROCESSED_DIR=data/processed
# Where files that cannot be imported are moved. Default: data/failed.
IMPORT_WORKER_FAILED_DIR=data/failed
# Seconds to wait between two passes over the inbox. Default: 5.0.
IMPORT_WORKER_POLL_INTERVAL_SECONDS=5.0
# Base URL of catalog-service. Default: http://localhost:8000.
IMPORT_WORKER_CATALOG_URL=http://localhost:8000
# Seconds to wait for catalog-service per request. Default: 5.0.
IMPORT_WORKER_CATALOG_TIMEOUT_SECONDS=5.0
# Python log level: CRITICAL, ERROR, WARNING, INFO or DEBUG. Default: INFO.
IMPORT_WORKER_LOG_LEVEL=INFO
